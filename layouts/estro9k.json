{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.16"
  },
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "link_handlers": [
    "cria-file-preview"
  ],
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "better-sidebar"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "better-sidebar",
                "props": {
                  "view": "agents"
                }
              }
            }
          ]
        },
        {
          "id": "usage",
          "type": "block",
          "size": {
            "px": 150
          },
          "content": {
            "mod": "over9k-usage"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "weight": 1
              },
              "window_drag": true,
              "content": {
                "mod": "better-tabs",
                "props": {
                  "rememberPanels": {
                    "container": "panel",
                    "stack": "panel-body"
                  },
                  "buttons": [
                    {
                      "id": "files",
                      "label": "Files",
                      "icon": "file",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "label": "Changes",
                      "icon": "changes",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "changes"
                      }
                    },
                    {
                      "id": "plans",
                      "label": "Plan",
                      "icon": "mods/agent-plans/plan.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "plans"
                      }
                    },
                    {
                      "id": "todos",
                      "label": "To-do",
                      "icon": "mods/workspace-chrome/circle-check.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "todos"
                      }
                    }
                  ]
                }
              }
            },
            {
              "id": "panel-toggle",
              "type": "block",
              "size": {
                "px": 36
              },
              "content": {
                "mod": "better-sidebar",
                "props": {
                  "view": "panel-toggle"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "cria-files-extended",
                        "props": {
                          "open": "split-right"
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "plans",
                      "type": "block",
                      "content": {
                        "mod": "agent-plans"
                      }
                    },
                    {
                      "id": "todos",
                      "type": "block",
                      "content": {
                        "mod": "over9k-todos"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 30
          },
          "content": {
            "mod": "custom-status"
          }
        }
      ]
    }
  ]
}